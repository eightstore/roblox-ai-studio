{
  "name": "roblox-ai-studio",
  "version": "1.0.0",
  "description": "Studio AI komunitas Roblox: Trend Scout + Kobbie, Bruno, Sesko, DALOT",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "run-once": "tsx src/index.ts --once",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:init": "tsx src/lib/initDb.ts",
    "reset": "node -e \"const fs=require('fs');for(const d of ['storage/database','storage/items'])fs.rmSync(d,{recursive:true,force:true});console.log('Data uji coba dihapus. Jalankan npm start lagi.')\""
  },
