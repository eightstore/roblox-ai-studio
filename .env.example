# --- Otak AI ---
# Kosongkan ANTHROPIC_API_KEY untuk MODE DEMO: agent memakai contoh output, gratis, cocok untuk uji lokal.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Database ---
# KOSONGKAN untuk uji coba di laptop: database bawaan otomatis dibuat di folder storage/database.
# Untuk Docker (docker-compose.yml): postgres://postgres:postgres@localhost:5432/postgres
# Untuk Supabase: Project Settings -> Database -> Connection string (Session pooler)
DATABASE_URL=

# --- Studio ---
GROUP_NAME=Nama Grup Kamu
# Jam jalan siklus (format cron, zona waktu di bawah). Default: tiap hari 02:00
CYCLE_CRON=0 2 * * *
TZ_NAME=Asia/Jakarta

# --- Admin dashboard ---
ADMIN_TOKEN=admin123
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# --- Generator gambar ---
# Gemini API (Google AI Studio -> Get API key). Kosongkan = gambar placeholder garis-garis (gratis).
GEMINI_API_KEY=
# Model dicoba berurutan (pisahkan dengan koma); ganti kalau Google merilis model baru.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image,gemini-3.1-flash-image-preview

# Alternatif: endpoint HTTP lain yang menerima {prompt,width,height} dan mengembalikan PNG
IMAGE_API_URL=
IMAGE_API_KEY=

# --- Roblox Open Cloud ---
ROBLOX_API_KEY=
ROBLOX_GROUP_ID=
# true hanya setelah kamu cek dokumentasi Open Cloud bahwa assetType Shirt didukung untuk API key-mu
ROBLOX_AUTO_UPLOAD=false

# --- Monitoring ---
DISCORD_WEBHOOK_URL=
