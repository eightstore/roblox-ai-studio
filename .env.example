# --- Otak AI ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Database (Supabase -> Project Settings -> Database -> Connection string) ---
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# --- Studio ---
GROUP_NAME=Nama Grup Kamu
# Jam jalan siklus (format cron, zona waktu di bawah). Default: tiap hari 02:00
CYCLE_CRON=0 2 * * *
TZ_NAME=Asia/Jakarta

# --- Admin dashboard ---
ADMIN_TOKEN=ganti-dengan-token-panjang-acak
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# --- Generator gambar (endpoint HTTP apa pun yang menerima {prompt,width,height} dan mengembalikan PNG) ---
# Kosongkan untuk mode placeholder (tekstur warna dari palet, tanpa biaya API)
IMAGE_API_URL=
IMAGE_API_KEY=

# --- Roblox Open Cloud ---
ROBLOX_API_KEY=
ROBLOX_GROUP_ID=
# true hanya setelah kamu cek dokumentasi Open Cloud bahwa assetType Shirt didukung untuk API key-mu
ROBLOX_AUTO_UPLOAD=false

# --- Monitoring ---
DISCORD_WEBHOOK_URL=
